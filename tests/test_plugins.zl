# tests/test_plugins.zl
# Tests para el sistema de plugins

print("=== Test Sistema de Plugins ===")

# --- Test 1: Load legacy plugin ---
print("\n=== Test 1: Legacy Plugin (load_lib) ===")
load_lib("./libtestnative.so", {
    "native_double": "fn($x) -> $x",
    "native_pow": "fn($a, $b) -> $a"
})
print("native_double(21) =", native_double(21))
print("native_pow(2, 10) =", native_pow(2, 10))

