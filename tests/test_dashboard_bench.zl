print("\n==============================================")
print("  SUMMARY")
print("==============================================")
print("  Iris       (150 rows):    8 nodes")
print("  Titanic    (891 rows):   13 nodes")
print("  Ventas   (100K rows):   14 nodes")
print("  Adult    (48K rows):    13 nodes")
print("  All dashboards saved to tests/bench_*.json")
print("==============================================")
