$datos = load_csv("tests/datos.csv")
print("Cargados datos correctamente")
$promedio_ventas = mean($datos:ventas)
$total_ventas = sum($datos:ventas)
$total_gastos = sum($datos:gastos)
$utilidad = $total_ventas - $total_gastos
print("Promedio ventas:", $promedio_ventas)
print("Total ventas:", $total_ventas)
print("Total gastos:", $total_gastos)
print("Utilidad:", $utilidad)
metric("ventas_promedio", $promedio_ventas)
metric("ventas_total", $total_ventas)
metric("gastos_total", $total_gastos)
metric("utilidad", $utilidad)
