fn ping($req) {
    return {
        "status": 200,
        "body": "pong",
        "headers": {"Content-Type": "text/plain"}
    }
}

$r1 = route("GET", "/api/ping", ping)
print("registered #", $r1)

fn echo_post($req) {
    return {
        "status": 200,
        "body": "got",
        "headers": {}
    }
}

$r2 = route("POST", "/api/echo", echo_post)
print("registered #", $r2)

fn echo_get($req) {
    return {
        "status": 200,
        "body": "delete-ok",
        "headers": {}
    }
}

$r3 = route("DELETE", "/api/x", echo_get)
print("registered #", $r3)

fn echo_put($req) {
    return {
        "status": 200,
        "body": "put-ok",
        "headers": {}
    }
}

$r4 = route("PUT", "/api/y", echo_put)
print("registered #", $r4)

fn echo_patch($req) {
    return {
        "status": 200,
        "body": "patch-ok",
        "headers": {}
    }
}

$r5 = route("PATCH", "/api/z", echo_patch)
print("registered #", $r5)

print("OK route registration")
